{
  "name": "srs-saas",
  "version": "0.1.0",
  "private": true,
  "description": "School Report Maker SaaS \u2014 multi-tenant school management & report platform (Uganda)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "build": "prisma generate && next build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "19.3.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^5.20.0",
    "docx": "^9.7.1",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  }
}